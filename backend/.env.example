# Puerto en el que se ejecuta el servidor Express del Backend
PORT=3000

# URI de conexión local a MongoDB (MongoDB Compass / Community Server)
MONGO_URI=mongodb://localhost:27017/basededatos

# Clave privada para firmar y verificar tokens JWT (reemplazar por una clave larga y aleatoria)
JWT_SECRET=reemplazar_por_una_clave_larga_y_aleatoria

# Tiempo de expiración de los tokens JWT (ej: 1h, 2h)
JWT_EXPIRES_IN=2h
