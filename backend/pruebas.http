# Archivo de pruebas HTTP para la extensión REST Client de VS Code
# Cambiá @baseUrl por tu URL de Render cuando quieras probar el backend desplegado en la nube
@baseUrl = http://localhost:3000

### ============================================================================
### 1. AUTENTICACIÓN (LOGIN ADMIN Y USUARIO DE CONSULTA)
### ============================================================================

# Inicia sesión como administrador y guarda el token en la variable @tokenAdmin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@sga.com",
    "password": "claveAdmin123"
}

###
@tokenAdmin = {{loginAdmin.response.body.token}}

# Inicia sesión como usuario de consulta y guarda el token en la variable @tokenConsulta
# @name loginConsulta
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "consulta@sga.com",
    "password": "claveUsuario123"
}

###
@tokenConsulta = {{loginConsulta.response.body.token}}

# Prueba de login con contraseña incorrecta (esperado: 401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@sga.com",
    "password": "PasswordIncorrecta"
}

### ============================================================================
### 2. PRUEBAS DE SEGURIDAD (JWT Y CONTROL DE ROLES)
### ============================================================================

# Consulta de alumnos sin token (esperado: 401 Acceso no autorizado)
GET {{baseUrl}}/alumnos

###
# Consulta de alumnos con token modificado (esperado: 401 Token inválido o expirado)
GET {{baseUrl}}/alumnos
Authorization: Bearer token_invalido_o_modificado

###
# Usuario de consulta leyendo alumnos (esperado: 200 OK)
GET {{baseUrl}}/alumnos
Authorization: Bearer {{tokenConsulta}}

###
# Usuario de consulta intentando crear un alumno (esperado: 403 Forbidden)
POST {{baseUrl}}/alumnos
Content-Type: application/json
Authorization: Bearer {{tokenConsulta}}

{
    "legajo": 9999,
    "nombre": "Prueba Sin Permiso",
    "carrera": "Programación",
    "correo": "sinpermiso@mail.com"
}

###
# Usuario de consulta intentando crear un docente (esperado: 403 Forbidden)
POST {{baseUrl}}/docentes
Content-Type: application/json
Authorization: Bearer {{tokenConsulta}}

{
    "dni": 99999999,
    "nombre": "Docente Sin Permiso",
    "especialidad": "Pruebas",
    "correo": "docente.sinpermiso@mail.com"
}

###
# Usuario de consulta intentando crear una materia (esperado: 403 Forbidden)
POST {{baseUrl}}/materias
Content-Type: application/json
Authorization: Bearer {{tokenConsulta}}

{
    "codigo": "TEST403",
    "nombre": "Materia Sin Permiso",
    "cargaHoraria": 64,
    "estado": "activa"
}

### ============================================================================
### 3. CRUD DE ALUMNOS (CON TOKEN DE ADMINISTRADOR)
### ============================================================================

# Lista todos los alumnos ordenados por legajo
GET {{baseUrl}}/alumnos
Authorization: Bearer {{tokenAdmin}}

###
# Consulta un alumno puntual por legajo
GET {{baseUrl}}/alumnos/1002
Authorization: Bearer {{tokenAdmin}}

###
# Registra un nuevo alumno (requiere rol admin)
POST {{baseUrl}}/alumnos
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "legajo": 1025,
    "nombre": "Lucía Pérez",
    "carrera": "Programación",
    "correo": "lucia@mail.com"
}

###
# Modifica un alumno existente por legajo (requiere rol admin)
PUT {{baseUrl}}/alumnos/1002
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "nombre": "Juan Carlos Gómez",
    "carrera": "Programación",
    "correo": "juan@mail.com"
}

###
# Elimina un alumno por legajo (requiere rol admin)
DELETE {{baseUrl}}/alumnos/1025
Authorization: Bearer {{tokenAdmin}}

### ============================================================================
### 4. CRUD DE DOCENTES (CON TOKEN DE ADMINISTRADOR)
### ============================================================================

# Lista todos los docentes ordenados por DNI
GET {{baseUrl}}/docentes
Authorization: Bearer {{tokenAdmin}}

###
# Registra un nuevo docente (requiere rol admin)
POST {{baseUrl}}/docentes
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "dni": 35222311,
    "nombre": "Marcos López",
    "especialidad": "Arquitectura Web",
    "correo": "marcos@mail.com"
}

###
# Elimina el docente de prueba por DNI (requiere rol admin)
DELETE {{baseUrl}}/docentes/35222311
Authorization: Bearer {{tokenAdmin}}

### ============================================================================
### 5. CRUD Y VALIDACIONES DEL MÓDULO MATERIAS (CON TOKEN DE ADMINISTRADOR)
### ============================================================================

# 1. Consultar todas las materias
GET {{baseUrl}}/materias
Authorization: Bearer {{tokenAdmin}}

###
# 2. Registrar una materia válida (PRG1)
POST {{baseUrl}}/materias
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "codigo": "PRG1",
    "nombre": "Programación I",
    "descripcion": "Fundamentos de algoritmos y lógica de programación",
    "cargaHoraria": 64,
    "estado": "activa"
}

###
# 3. Consultar una materia por su código
GET {{baseUrl}}/materias/PRG4
Authorization: Bearer {{tokenAdmin}}

###
# 4. Consultar un código inexistente (esperado: 404)
GET {{baseUrl}}/materias/MAT99
Authorization: Bearer {{tokenAdmin}}

###
# 5. Registrar una materia de prueba válida (BD9)
POST {{baseUrl}}/materias
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "codigo": "BD9",
    "nombre": "Bases de Datos de Prueba",
    "descripcion": "Modelado relacional y NoSQL",
    "cargaHoraria": 64,
    "estado": "activa"
}

###
# 6. Intentar registrar una materia sin código (esperado: 400)
POST {{baseUrl}}/materias
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "nombre": "Matemática I",
    "descripcion": "Álgebra y análisis",
    "cargaHoraria": 64,
    "estado": "activa"
}

###
# 7. Intentar registrar una materia sin nombre (esperado: 400)
POST {{baseUrl}}/materias
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "codigo": "MAT1",
    "descripcion": "Álgebra y análisis",
    "cargaHoraria": 64,
    "estado": "activa"
}

###
# 8. Intentar registrar una materia con carga horaria inválida (esperado: 400)
POST {{baseUrl}}/materias
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "codigo": "MAT1",
    "nombre": "Matemática I",
    "cargaHoraria": 0,
    "estado": "activa"
}

###
# 9. Intentar registrar una materia con código duplicado (esperado: 400)
POST {{baseUrl}}/materias
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "codigo": "PRG4",
    "nombre": "Otra Materia con Código Repetido",
    "cargaHoraria": 60,
    "estado": "activa"
}

###
# 10. Intentar registrar una materia con un estado no permitido (esperado: 400)
POST {{baseUrl}}/materias
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "codigo": "ING1",
    "nombre": "Inglés Técnico I",
    "cargaHoraria": 48,
    "estado": "pendiente"
}

###
# 11. Modificar nombre, descripción, carga horaria y estado de una materia existente
PUT {{baseUrl}}/materias/BD9
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "nombre": "Bases de Datos Actualizada",
    "descripcion": "Diseño y consultas sobre MongoDB",
    "cargaHoraria": 80,
    "estado": "inactiva"
}

###
# 12. Intentar modificar una materia inexistente (esperado: 404)
PUT {{baseUrl}}/materias/NOEXISTE
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "nombre": "Materia Inexistente",
    "cargaHoraria": 64,
    "estado": "activa"
}

###
# 13. Eliminar la materia de prueba BD9
DELETE {{baseUrl}}/materias/BD9
Authorization: Bearer {{tokenAdmin}}
