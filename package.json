{
  "name": "sga-monorepo",
  "version": "1.3.0",
  "private": true,
  "description": "Sistema de Gestión Académica (SGA) - Programación IV",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "crear-admin": "node backend/crearUsuario.js",
    "crear-usuario": "node backend/nuevoUsuario.js",
    "seed": "node backend/crearUsuario.js && node backend/nuevoUsuario.js",
    "frontend": "npm --prefix frontend-react run dev",
    "build": "npm --prefix frontend-react run build"
  },
